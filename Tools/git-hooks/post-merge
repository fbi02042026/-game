#!/bin/sh
# git post-merge hook：每次 pull / merge 完成后干两件事
#   1) 安全网：检测「成片文件消失」并自动从索引恢复（2026-09-23 事故后新增）
#   2) 打印当前待办清单（原功能）
#
# 安装（仓库根目录执行一次即可）：
#   cp Tools/git-hooks/post-merge .git/hooks/post-merge
# Windows（Git Bash 同理）：
#   copy Tools\git-hooks\post-merge .git\hooks\post-merge
#
# 说明：.git/hooks 不受版本控制，所以换机器 / 新克隆后要重新安装一次。
#
# ---------------------------------------------------------------------------
# 为什么要有第 1 条（2026-09-23 事故，1944 个文件在 pull 的 70 秒内被删进回收站）
#   git 侧表现为 2095 个 ` D`（未暂存删除）。当时靠手工敲
#   `git checkout-index -f -a` 救回来了。这次把同样的动作做成自动的：
#   pull 完立刻自检，成片删除就当场恢复，不让问题拖到「界面不对」才发现。
#   ⚠ 恢复用的是【索引内容 = 刚拉下来的 HEAD】：已提交的东西能 100% 回来，
#     但【未提交的本地改动】会被覆盖，git 救不回来 —— 只能去回收站捞。
# ---------------------------------------------------------------------------

# ===== 1) 安全网：成片删除自动恢复 =====
DEL=$(git diff --name-only --diff-filter=D 2>/dev/null | wc -l | tr -d ' ')
if [ "$DEL" -gt 20 ]; then
    echo ""
    echo "⚠⚠⚠  pull 后有 $DEL 个文件从工作区消失 —— 正在自动从索引恢复"
    git checkout-index -f -a
    LEFT=$(git status --short 2>/dev/null | grep -c '^ D' | tr -d ' ')
    echo "      恢复完成，仍缺失：$LEFT 个"
    if [ "$LEFT" -gt 0 ]; then
        echo "      ❗ 仍有缺失，手动补一刀："
        echo "         git diff --name-only --diff-filter=D -z | xargs -0 -n 50 git checkout HEAD --"
    fi
    echo ""
    echo "      恢复的是【已提交内容】。若你pull前有未提交的改动，去回收站捞："
    echo "         python Tools/prefab-analysis/scan_recycle_bin.py"
    echo "      然后重启团结编辑器让它重新导入（否则缓存错位会白框 / 界面不对）。"
    echo ""
fi

# ===== 2) 打印待办 =====
TODO="Docs/待办清单_2026-09-18.md"
if [ ! -f "$TODO" ]; then
    exit 0
fi

echo ""
echo "=============================================="
echo " 拉取完成 · 当前待办事项（$TODO）"
echo "=============================================="
# 打印 §2「还没做」整节，直到 §3 为止
sed -n '/^## 2\./,/^## 3\./p' "$TODO" | sed '/^## 3\./d'
echo "=============================================="
echo " 完整清单见：$TODO"
echo "=============================================="
echo ""
