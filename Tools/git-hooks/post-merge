#!/bin/sh
# git post-merge hook：pull / merge 完成后干两件事
#   1) 安全网：检测「成片文件消失」并【只补缺失的那批文件】
#   2) 打印当前待办清单
#
# 安装（仓库根目录执行一次即可）：
#   cp Tools/git-hooks/post-merge .git/hooks/post-merge
# Windows（Git Bash 同理）：
#   copy Tools\git-hooks\post-merge .git\hooks\post-merge
#
# 说明：.git/hooks 不受版本控制，所以换机器 / 新克隆后要重新安装一次。
#
# ---------------------------------------------------------------------------
# 2026-09-24 重写（主人拍板：不经同意不许动工作区；原版有缺陷，已实测确认）
#
#   ❌ 旧版缺陷（实测证据见 Docs/拉取时文件进回收站_取证报告_2026-09-24.md）
#      1) 一旦判定成片删除就跑 `git checkout-index -f -a`：
#         隔离实验证明 —— 它会把【未提交的本地改动静默覆盖回旧版本】，
#         而且覆盖后 `git status` 仍显示 ` M`，不打开文件根本发现不了。
#      2) `-a` 是【全量重写】：实测一次重写约 1900 个文件，
#         在 E 盘（删除会进回收站）表现为又一大批文件被"删"。
#
#   ✅ 现在的行为
#      a) 阈值 20 → 200：只有真·成片消失才动手，正常 pull 不再触发
#      b) 工作区只要存在【真实未提交改动】，一律不自动恢复，
#         只报警 + 把失踪名单写到 .git/last_pull_missing.txt，交主人决定
#         （CRLF 假改动不算真实改动：git diff --numstat 为空，仍会自动恢复）
#      c) 只恢复【确实缺失的那批文件】，不再 -a 全量重写
# ---------------------------------------------------------------------------

DEL=$(git diff --name-only --diff-filter=D 2>/dev/null | grep -c .)
# 注意：--diff-filter=d（小写 d）= 排除「已删除」，否则缺失文件本身会被算成改动，
#       导致"明明该恢复却因为自认为有改动而停手"（2026-09-24 实测踩到）。
DIRTY=$(git diff --numstat --diff-filter=d 2>/dev/null | grep -c .)
STAGED=$(git diff --cached --numstat --diff-filter=d 2>/dev/null | grep -c .)

if [ "$DEL" -gt 200 ]; then
    echo ""
    echo "⚠⚠⚠  pull 后有 $DEL 个文件从工作区消失"
    git diff --name-only --diff-filter=D > .git/last_pull_missing.txt 2>/dev/null
    echo "      失踪名单已写入 .git/last_pull_missing.txt"

    if [ "$DIRTY" -gt 0 ] || [ "$STAGED" -gt 0 ]; then
        echo ""
        echo "      ❌ 检测到未提交的本地改动（工作区 $DIRTY 个 / 暂存区 $STAGED 个）"
        echo "      按规矩不碰你的改动，已停止自动恢复。确认要恢复缺失文件时手动执行："
        echo "         git diff --name-only --diff-filter=D -z | xargs -0 -r -n 50 git checkout HEAD --"
    else
        echo "      工作区无真实改动（CRLF 假改动不算），开始只补缺失的这批文件……"
        git diff --name-only --diff-filter=D -z 2>/dev/null | xargs -0 -r -n 50 git checkout HEAD --
        LEFT=$(git status --short 2>/dev/null | grep -c '^ D')
        echo "      恢复完成，仍缺失：$LEFT 个"
    fi
    echo ""
    echo "      说明：恢复的是【已提交内容】。若在 pull 前有未提交改动，只能去回收站捞："
    echo "         python Tools/prefab-analysis/scan_recycle_bin.py"
    echo "      然后重启团结编辑器让它重新导入（否则缓存错位会白框 / 界面不对）。"
    echo ""
fi

# ===== 打印待办 =====
TODO="Docs/待办清单_2026-09-18.md"
if [ ! -f "$TODO" ]; then
    exit 0
fi

echo ""
echo "=============================================="
echo " 拉取完成 · 当前待办事项（$TODO）"
echo "=============================================="
# 打印 §2「还没做」整节，直到 §3 为止
sed -n '/^## 2\./,/^## 3\./p' "$TODO" | sed '/^## 3\./d'
echo "=============================================="
echo " 完整清单见：$TODO"
echo "=============================================="
echo ""
